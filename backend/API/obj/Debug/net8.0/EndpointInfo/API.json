  "components": {
    "schemas": {
      "ApproveClaimRequest": {
        "type": "object",
        "properties": {
          "approvedAmount": {
            "type": "number",
            "format": "double"
          },
          "remarks": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ApproveRequestPayload": {
        "type": "object",
        "properties": {
          "remarks": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CompleteVerificationRequest": {
        "type": "object",
        "properties": {
          "remarks": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateClaimRequest": {
        "type": "object",
        "properties": {
          "policyId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "documentUrl": {
            "type": "string",
            "nullable": true
          },
          "documentHash": {
            "type": "string",
            "nullable": true
          },
          "incidentLatitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "incidentLongitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePlanDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "premiumAmount": {
            "type": "number",
            "format": "double"
          },
          "coverageAmount": {
            "type": "number",
            "format": "double"
          },
          "durationInMonths": {
            "type": "integer",
            "format": "int32"
          },
          "paymentFrequency": {
            "type": "string",
            "nullable": true
          },
          "planType": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PaymentFrequency": {
        "enum": [
          "Monthly",
          "Quarterly",
          "Yearly"
        ],
        "type": "string"
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
